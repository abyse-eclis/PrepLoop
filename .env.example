# Supabase (จาก Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — ใช้ฝั่ง server เท่านั้น ห้าม expose ใน client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (สำหรับ Recovery ด้วย Claude Haiku) — ไม่ใส่ก็ได้ ระบบจะใช้ mock mode
ANTHROPIC_API_KEY=
# อ่าน model จาก env เสมอ อย่า hardcode
ANTHROPIC_RECOVERY_MODEL=claude-haiku-4-5-20251001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage upload limit (MB) — ควรตรงกับ Supabase "Global file size limit"
# (Free plan ล็อกที่ 50MB). ไฟล์ที่ใหญ่กว่านี้ระบบจะบันทึกเป็น "ข้อมูลอ้างอิง"
# (เก็บแค่ชื่อไฟล์ ไม่เก็บไฟล์จริง) แทนการอัปโหลด
# อัปโหลดตรงไป Supabase Storage (ไม่ผ่าน Vercel) จึงไม่ติดลิมิต 4.5MB ของ Vercel
MAX_UPLOAD_SIZE_MB=50
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
