# Supabase (จาก Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — ใช้ฝั่ง server เท่านั้น ห้าม expose ใน client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (สำหรับ Recovery ด้วย Claude Haiku) — ไม่ใส่ก็ได้ ระบบจะใช้ mock mode
ANTHROPIC_API_KEY=
# อ่าน model จาก env เสมอ อย่า hardcode
ANTHROPIC_RECOVERY_MODEL=claude-haiku-4-5-20251001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upload limit (MB) — ตรวจทั้ง client และ server (ค่าเริ่มต้น 100)
# ไฟล์อัปโหลดตรงไป Supabase Storage (ไม่ผ่าน Vercel) จึงไม่ติดลิมิต 4.5MB ของ Vercel
# แต่ยังต้องตั้ง bucket file_size_limit (migration 0007) และ Project upload limit
# ใน Supabase Dashboard → Storage → Settings ให้ >= ค่านี้ด้วย
MAX_UPLOAD_SIZE_MB=100
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=100
