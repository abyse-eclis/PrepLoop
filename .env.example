# Supabase (จาก Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — ใช้ฝั่ง server เท่านั้น ห้าม expose ใน client
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (สำหรับ Recovery ด้วย Claude Haiku) — ไม่ใส่ก็ได้ ระบบจะใช้ mock mode
ANTHROPIC_API_KEY=
# อ่าน model จาก env เสมอ อย่า hardcode
ANTHROPIC_RECOVERY_MODEL=claude-haiku-4-5-20251001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# หมายเหตุ: ไฟล์แหล่งเรียนถูกเก็บเป็น "ชื่ออ้างอิง" เท่านั้น (ไม่อัปโหลดไฟล์จริง
# ขึ้น Storage) จึงไม่มีข้อจำกัดขนาดไฟล์ ตัวแปรด้านล่างเป็น optional/ไม่จำเป็น
# MAX_UPLOAD_SIZE_MB=50
# NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
